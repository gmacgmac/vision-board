#!/bin/sh
# On main, a merge or pull that changed the skill copies it into each installed client (D-118).
# One-time setup: git config core.hooksPath .githooks (SETUP.md § 5).
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
git diff --name-only ORIG_HEAD HEAD -- skills/vision-board/ | grep -q . || exit 0
npm run --silent skill:install || true
