{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/ledger/23/events/reply.schema.json",
  "title": "Reply event",
  "description": "The agent answers an item without redrawing it. `to` is the seq of the act it answers.",
  "$defs": {
    "core": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"$ref": "https://vision-board.invalid/schema/ledger/23/common.schema.json#/$defs/longText", "description": "Your answer to the person."},
        "to": {"$ref": "https://vision-board.invalid/schema/ledger/23/common.schema.json#/$defs/seq", "description": "The `seq` of the person's action that you are answering."}
      }
    },
    "sent": {
      "examples": [{"type": "reply", "key": "fee-reply", "n": 1, "text": "Per seat: it matches how the team grows."}],
      "type": "object",
      "required": ["type", "n"],
      "properties": {
        "type": {"const": "reply"},
        "n": {"$ref": "https://vision-board.invalid/schema/ledger/23/common.schema.json#/$defs/nodeRef"},
        "key": {"$ref": "https://vision-board.invalid/schema/ledger/23/common.schema.json#/$defs/key"}
      },
      "allOf": [
        {
          "$ref": "https://vision-board.invalid/schema/ledger/23/events/reply.schema.json#/$defs/core"
        }
      ],
      "unevaluatedProperties": false
    },
    "stored": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "reply"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/23/common.schema.json#/$defs/stamp"},
        {
          "$ref": "https://vision-board.invalid/schema/ledger/23/common.schema.json#/$defs/stampAgent"
        },
        {
          "$ref": "https://vision-board.invalid/schema/ledger/23/events/reply.schema.json#/$defs/core"
        },
        {
          "type": "object",
          "required": ["n"],
          "properties": {
            "by": {"enum": ["agent", "person"], "description": "Who wrote the line: `agent`, or `person` for a reply the person imported (it then has `from`)."},
            "from": {"$ref": "https://vision-board.invalid/schema/ledger/23/common.schema.json#/$defs/from", "description": "On a reply an import wrote: the agent whose words they are, from the board the file came from (`by: agent`)."},
            "n": {"$ref": "https://vision-board.invalid/schema/ledger/23/common.schema.json#/$defs/nodeNumber", "description": "The node number."},
            "key": {"$ref": "https://vision-board.invalid/schema/ledger/23/common.schema.json#/$defs/key"}
          }
        },
        {
          "$comment": "Only an imported reply (with `from`) may be the person's.",
          "if": {"type": "object", "not": {"required": ["from"]}},
          "then": {"type": "object", "properties": {"by": {"const": "agent"}}}
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
