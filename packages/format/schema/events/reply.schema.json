{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/ledger/3/events/reply.schema.json",
  "title": "Ledger v3: the `reply` event",
  "description": "The agent answers an item without redrawing it. `to` is the seq of the act it answers.",
  "$defs": {
    "core": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/longText"},
        "to": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/seq"}
      }
    },
    "sent": {
      "type": "object",
      "required": ["type", "n"],
      "properties": {
        "type": {"const": "reply"},
        "n": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/nodeRef"},
        "key": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/key"}
      },
      "allOf": [
        {
          "$ref": "https://vision-board.invalid/schema/ledger/3/events/reply.schema.json#/$defs/core"
        }
      ],
      "unevaluatedProperties": false
    },
    "stored": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "reply"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/stamp"},
        {
          "$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/stampAgent"
        },
        {
          "$ref": "https://vision-board.invalid/schema/ledger/3/events/reply.schema.json#/$defs/core"
        },
        {
          "type": "object",
          "required": ["n"],
          "properties": {
            "by": {"const": "agent"},
            "n": {
              "$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/nodeNumber"
            },
            "key": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/key"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
