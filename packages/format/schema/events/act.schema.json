{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/ledger/22/events/act.schema.json",
  "title": "Act event",
  "description": "One action from the action registry. `rules` says which fields each action needs; whether it is person-only lives in packages/actions.",
  "$comment": "Was: rule 8; api.md 9",
  "$defs": {
    "core": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"enum": ["ack", "drop", "comment", "context", "later", "reopen", "pin", "unpin", "mode", "grant", "deny", "revoke", "size", "send", "note-edit", "note-remove", "move", "reject", "bookmark", "unbookmark", "notes-hide", "notes-show", "widths", "archive", "restore", "lock", "unlock", "app-allow", "app-revoke", "skin", "ask", "direction"], "description": "Which action to take, from the action registry. `bookmark`, `unbookmark`, `notes-hide`, `notes-show`, `archive`, `restore`, `lock` and `unlock` are the person's own marks, whose lines no agent ever reads (`notes-hide` puts away the notes on one card, `notes-show` brings them back); a locked board shows as `locked` on `get_board` and `list_boards`. `app-allow` lets an app's tools run at one version of its code, and `app-revoke` stops them; each is on the app, not on a board. `skin` sets the board's skin; `ask` records the person's notes sent at once, apart from Send (Ask now); `direction` sets which way a flow runs."},
        "n": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/nodeNumber", "description": "The card the action is about: its number on the board in a request or an answer, its ledger number on a stored line."},
        "ver": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/version", "description": "The node version the person was looking at."},
        "text": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/longText", "description": "The person's words, for `comment`, `context`, `deny` and `note-edit` (the note's new text)."},
        "proposal": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/seq", "description": "The `seq` of the proposal being accepted, with its own action (`ack` or `drop`), or turned down, with `reject`."},
        "x": {"type": "number", "description": "Where to place the node across, for `pin`: in its container's coordinates for a card, in board coordinates (the frame's top-left) for a container."},
        "y": {"type": "number", "description": "Where to place the node down, for `pin`: in its container's coordinates for a card, in board coordinates (the frame's top-left) for a container."},
        "board": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/id", "description": "The board the action is about, for `mode`, `widths`, `revoke`, `send`, `archive`, `restore`, `lock` and `unlock`, and for a note on or a place for a whole container (with `region`)."},
        "region": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/id", "description": "The container the action is about, for `mode`, `widths` and `revoke` (a `revoke` without it removes access to the whole board); for `move`, the container the cards go in: one on their board, or `later`, the board's built-in Later. On a `comment`, `context`, `note-edit`, `note-remove`, `pin` or `unpin`, it names a whole container in place of `n` (with `board`); `pin` and `unpin` may name `later`."},
        "mode": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/lineMode", "description": "The layout mode to set, for `mode`: `grid`, `flow`, `lanes`, `radial`, `column` or `row`."},
        "widths": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/widths", "description": "The card widths to set, for `widths`: `match` or `own`.", "$comment": "Was: api.md 132"},
        "request": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/seq", "description": "The `seq` of the grant request being answered, for `grant` and `deny`."},
        "holder": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/agentId", "description": "The agent whose access is removed, for `revoke`: to the container, or with no `region` to the board."},
        "size": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/actSize", "description": "The card size: `s`, `m`, `l`, or `auto` to clear it, for `size`."},
        "note": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/seq", "description": "The `seq` of the `comment` or `context` act that made the note, for `note-edit` and `note-remove`."},
        "kind": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/noteKind", "description": "What the edited note now asks for, for `note-edit`: `comment` or `context`. Left out, the note keeps its kind."},
        "nodes": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/nodeNumbers", "description": "A group of cards, two or more, all on one board, in place of `n` (and `ver`): the items a note is on, for `comment` and `context`, or the cards a `move` puts in one container. Board numbers in a request or an answer, ledger numbers on a stored line."},
        "app": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/id", "description": "The app, for `app-allow` and `app-revoke`: its folder's name in `.visionboard/apps/`.", "$comment": "Was: api.md 150"},
        "hash": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/appHash", "description": "The version of the app's code to allow, for `app-allow`: its hash, as list_apps gives it.", "$comment": "Was: api.md 150"},
        "head": {"type": "integer", "minimum": 0, "description": "For `send`: the ledger line its answers were read through, when a chat carried them; only the answers up to it count as sent, and a later one stays for the next Send. Left out, the Send covers every answer up to its own line (as a Send no chat carried). 0: none yet.", "$comment": "Was: api.md 169, point 377"},
        "skin": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/skin", "description": "The board's skin, for `skin`.", "$comment": "Was: api.md 183"},
        "lines": {"type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/seq"}, "description": "For `ask`: the `seq` of each note of the person's it carried (a `comment`, a `context` with words, or a note on several cards or on a container), on the act's board, none sent or asked before.", "$comment": "Was: api.md 188"},
        "context": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/askContext", "description": "For `ask`: what the agent was given with the notes: `node`, `board` or `session`.", "$comment": "Was: api.md 188"},
        "direction": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/actDirection", "description": "For `direction`: which way a flow runs, `across` or `down`, or `auto` to give back the agent's; on the container in `region`, or with none on the whole board.", "$comment": "Was: api.md 189"}
      }
    },
    "sent": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "act"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/22/events/act.schema.json#/$defs/core"},
        {"$ref": "https://vision-board.invalid/schema/ledger/22/events/act.schema.json#/$defs/rules"},
        {"$ref": "https://vision-board.invalid/schema/ledger/22/events/act.schema.json#/$defs/noList"}
      ],
      "unevaluatedProperties": false
    },
    "stored": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "act"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/stamp"},
        {
          "$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/stampAgent"
        },
        {"$ref": "https://vision-board.invalid/schema/ledger/22/events/act.schema.json#/$defs/core"},
        {"$ref": "https://vision-board.invalid/schema/ledger/22/events/act.schema.json#/$defs/rules"},
        {"$ref": "https://vision-board.invalid/schema/ledger/22/events/act.schema.json#/$defs/lineRules"}
      ],
      "unevaluatedProperties": false
    },
    "noList": {
      "description": "A `mode` act never names `list`: it was renamed `column`.",
      "$comment": "Kept apart from `core`, whose mode names `list` (`lineMode`), so a line or item naming it gets these words alone. Was: api.md 129",
      "type": "object",
      "properties": {"mode": {"$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/notList"}}
    },
    "lineRules": {
      "description": "A stored line names no `list` mode.",
      "$comment": "Kept apart from `rules`, which the sent form and check_responses share. Was: api.md 129",
      "$comment": "Always applies; through `if`/`then` so the generators read `mode` from `core`, not from this piece.",
      "if": {"type": "object"},
      "then": {"$ref": "https://vision-board.invalid/schema/ledger/22/events/act.schema.json#/$defs/noList"}
    },
    "rules": {
      "description": "What each action needs.",
      "$comment": "Kept apart from `core` so a failed rule never hides which fields are known (see common.schema.json `stampAgent`). Was: api.md 16, 58-62, 66, 71, 93, 128, 132, 135, 138, 150, 169",
      "type": "object",
      "allOf": [
        {
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "mode"}}},
          "then": {"type": "object", "required": ["board", "region", "mode"]}
        },
        {
          "$comment": "A container's card widths, like its mode (api.md 132).",
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "widths"}}},
          "then": {"type": "object", "required": ["board", "region", "widths"]}
        },
        {
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "move"}}},
          "then": {"type": "object", "required": ["region"]}
        },
        {
          "if": {
            "type": "object",
            "required": ["action"],
            "properties": {"action": {"const": "move"}},
            "not": {"required": ["nodes"]}
          },
          "then": {"type": "object", "required": ["n"]}
        },
        {
          "if": {
            "type": "object",
            "required": ["action"],
            "properties": {"action": {"enum": ["ack", "drop", "later", "reopen"]}}
          },
          "then": {"type": "object", "required": ["n", "ver"]}
        },
        {
          "if": {
            "type": "object",
            "required": ["action"],
            "properties": {"action": {"enum": ["comment", "context"]}},
            "not": {"anyOf": [{"required": ["nodes"]}, {"required": ["region"]}]}
          },
          "then": {"type": "object", "required": ["n", "ver"]}
        },
        {
          "$comment": "A container act (api.md 71): one of these actions naming a region is about the whole container.",
          "if": {
            "type": "object",
            "required": ["action", "region"],
            "properties": {"action": {"enum": ["comment", "context", "note-edit", "note-remove", "pin", "unpin"]}}
          },
          "then": {"type": "object", "required": ["board"], "properties": {"n": false, "ver": false, "nodes": false}}
        },
        {
          "if": {
            "type": "object",
            "required": ["action", "region"],
            "properties": {"action": {"enum": ["comment", "context"]}}
          },
          "then": {"type": "object", "required": ["text"]}
        },
        {
          "if": {"type": "object", "required": ["nodes"]},
          "then": {
            "type": "object",
            "properties": {"action": {"enum": ["comment", "context", "move"]}, "n": false, "ver": false}
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["nodes", "action"],
            "properties": {"action": {"enum": ["comment", "context"]}}
          },
          "then": {"type": "object", "required": ["text"]}
        },
        {
          "if": {
            "type": "object",
            "required": ["action"],
            "properties": {"action": {"enum": ["pin", "unpin", "note-edit", "note-remove"]}},
            "not": {"required": ["region"]}
          },
          "then": {"type": "object", "required": ["n"]}
        },
        {
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "size"}}},
          "then": {"type": "object", "required": ["n"]}
        },
        {
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "reject"}}},
          "then": {"type": "object", "required": ["n", "proposal"]}
        },
        {
          "$comment": "The bookmark and the hidden notes mark one card, whatever its version (api.md 128, 156, 182).",
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"enum": ["bookmark", "unbookmark", "notes-hide", "notes-show"]}}},
          "then": {"type": "object", "required": ["n"], "properties": {"ver": false, "region": false}}
        },
        {
          "$comment": "Archive, restore, lock and unlock mark a whole board, named by `board` and nothing else (api.md 135, 138).",
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"enum": ["archive", "restore", "lock", "unlock"]}}},
          "then": {"type": "object", "required": ["board"], "properties": {"n": false, "ver": false, "region": false, "nodes": false}}
        },
        {
          "$comment": "An allow names the app and the version of its code; a stop names the app; neither names anything else (api.md 150).",
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"enum": ["app-allow", "app-revoke"]}}},
          "then": {"type": "object", "required": ["app"], "properties": {"n": false, "ver": false, "nodes": false, "region": false, "board": false}}
        },
        {
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "app-allow"}}},
          "then": {"type": "object", "required": ["hash"]}
        },
        {
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "app-revoke"}}},
          "then": {"type": "object", "properties": {"hash": false}}
        },
        {
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "pin"}}},
          "then": {"type": "object", "required": ["x", "y"]}
        },
        {
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "comment"}}},
          "then": {"type": "object", "required": ["text"]}
        },
        {
          "if": {
            "type": "object",
            "required": ["action"],
            "properties": {"action": {"enum": ["grant", "deny"]}}
          },
          "then": {"type": "object", "required": ["request"]}
        },
        {
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "revoke"}}},
          "then": {"type": "object", "required": ["holder", "board"]}
        },
        {
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "size"}}},
          "then": {"type": "object", "required": ["size"]}
        },
        {
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "send"}}},
          "then": {"type": "object", "required": ["board"]}
        },
        {
          "if": {
            "type": "object",
            "required": ["action"],
            "properties": {"action": {"enum": ["note-edit", "note-remove"]}}
          },
          "then": {"type": "object", "required": ["note"]}
        },
        {
          "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "note-edit"}}},
          "then": {"type": "object", "required": ["text"]}
        },
        {"$comment": "Only a skin names a skin, only an ask its lines and context, only a direction a direction (api.md 183, 188, 189).", "if": {"type": "object", "anyOf": [{"required": ["skin"]}]}, "then": {"type": "object", "required": ["action"], "properties": {"action": {"const": "skin"}}}},
        {"if": {"type": "object", "anyOf": [{"required": ["lines"]}, {"required": ["context"]}]}, "then": {"type": "object", "required": ["action"], "properties": {"action": {"const": "ask"}}}},
        {"if": {"type": "object", "anyOf": [{"required": ["direction"]}]}, "then": {"type": "object", "required": ["action"], "properties": {"action": {"const": "direction"}}}},
        {"$comment": "A board's skin names its board and the skin, and nothing else (api.md 183).", "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "skin"}}}, "then": {"type": "object", "required": ["board", "skin"], "properties": {"n": false, "ver": false, "text": false, "proposal": false, "x": false, "y": false, "mode": false, "widths": false, "request": false, "holder": false, "size": false, "note": false, "kind": false, "nodes": false, "app": false, "hash": false, "head": false, "region": false, "lines": false, "context": false, "direction": false}}},
        {"$comment": "An ask names its board, the notes it carried and the context, and nothing else (api.md 188).", "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "ask"}}}, "then": {"type": "object", "required": ["board", "lines", "context"], "properties": {"n": false, "ver": false, "text": false, "proposal": false, "x": false, "y": false, "mode": false, "widths": false, "request": false, "holder": false, "size": false, "note": false, "kind": false, "nodes": false, "app": false, "hash": false, "head": false, "region": false, "skin": false, "direction": false}}},
        {"$comment": "A flow's direction names its board, one container or none, and the direction, and nothing else (api.md 189).", "if": {"type": "object", "required": ["action"], "properties": {"action": {"const": "direction"}}}, "then": {"type": "object", "required": ["board", "direction"], "properties": {"n": false, "ver": false, "text": false, "proposal": false, "x": false, "y": false, "mode": false, "widths": false, "request": false, "holder": false, "size": false, "note": false, "kind": false, "nodes": false, "app": false, "hash": false, "head": false, "skin": false, "lines": false, "context": false}}},
        {
          "$comment": "Only a Send says how far its answers were read (api.md 169).",
          "if": {"type": "object", "required": ["head"]},
          "then": {"type": "object", "required": ["action"], "properties": {"action": {"const": "send"}}}
        },
        {
          "if": {
            "type": "object",
            "required": ["action"],
            "properties": {"action": {"enum": ["grant", "deny", "revoke", "send"]}}
          },
          "then": {"type": "object", "properties": {"n": false}}
        }
      ]
    }
  }
}
