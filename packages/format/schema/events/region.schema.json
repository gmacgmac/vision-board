{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/ledger/3/events/region.schema.json",
  "title": "Region event",
  "description": "An agent adds a region (a container) or updates one by its id. The board comes from the path when sent.",
  "$comment": "Was: D-011; api.md 34",
  "$defs": {
    "core": {
      "type": "object",
      "required": ["region"],
      "properties": {
        "region": {"$ref": "https://vision-board.invalid/schema/ledger/3/events/region.schema.json#/$defs/region", "description": "The container to add, or to update when its id already exists."}
      }
    },
    "sent": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"const": "region"},
        "key": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/key"}
      },
      "allOf": [
        {
          "$ref": "https://vision-board.invalid/schema/ledger/3/events/region.schema.json#/$defs/core"
        }
      ],
      "unevaluatedProperties": false
    },
    "stored": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "region"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/stamp"},
        {
          "$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/stampAgent"
        },
        {
          "$ref": "https://vision-board.invalid/schema/ledger/3/events/region.schema.json#/$defs/core"
        },
        {
          "type": "object",
          "required": ["board"],
          "properties": {
            "by": {"const": "agent", "description": "Who wrote the line; always `agent` for this event."},
            "board": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/id", "description": "The board the line belongs to; the server takes it from the path."},
            "key": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/key"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "region": {
      "type": "object",
      "required": ["id", "title", "mode"],
      "properties": {
        "id": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/id", "description": "The container's id: lowercase letters, digits and hyphens. Send an id that already exists to update that container."},
        "title": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/regionTitle", "description": "The container's title, shown on the board."},
        "mode": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/mode", "description": "How the container lays out its cards: `grid`, `flow`, `lanes`, `radial` or `list`."},
        "lanes": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/lanes", "description": "Lane names, top to bottom. Required when the mode is `lanes`."},
        "center": {
          "$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/nodeNumber",
          "description": "The centre node's number",
          "$comment": "Was: api.md 18"
        },
        "columns": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/columns", "description": "How many columns a `grid` container uses, from 1 to 12."}
      },
      "if": {"type": "object", "required": ["mode"], "properties": {"mode": {"const": "lanes"}}},
      "then": {
        "type": "object",
        "required": ["lanes"],
        "properties": {"lanes": {"type": "array", "minItems": 1}}
      },
      "unevaluatedProperties": false
    }
  }
}
