{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/ledger/3/events/propose.schema.json",
  "title": "Ledger v3: the `propose` event",
  "description": "The agent proposes a decision on version `ver`; only the person can make it (D-018).",
  "$defs": {
    "core": {
      "type": "object",
      "required": ["ver", "action", "reason"],
      "properties": {
        "ver": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/version"},
        "action": {"enum": ["ack", "drop"]},
        "reason": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/longText"},
        "source": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/source"}
      }
    },
    "sent": {
      "type": "object",
      "required": ["type", "n"],
      "properties": {
        "type": {"const": "propose"},
        "n": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/nodeRef"},
        "key": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/key"}
      },
      "allOf": [
        {
          "$ref": "https://vision-board.invalid/schema/ledger/3/events/propose.schema.json#/$defs/core"
        }
      ],
      "unevaluatedProperties": false
    },
    "stored": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "propose"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/stamp"},
        {
          "$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/stampAgent"
        },
        {
          "$ref": "https://vision-board.invalid/schema/ledger/3/events/propose.schema.json#/$defs/core"
        },
        {
          "type": "object",
          "required": ["n"],
          "properties": {
            "by": {"const": "agent"},
            "n": {
              "$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/nodeNumber"
            },
            "key": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/key"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
