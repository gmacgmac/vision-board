{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/ledger/16/events/propose.schema.json",
  "title": "Propose event",
  "description": "The agent proposes a decision on version `ver`; only the person can make it.",
  "$comment": "Was: D-018",
  "$defs": {
    "core": {
      "type": "object",
      "required": ["ver", "action", "reason"],
      "properties": {
        "ver": {"$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/version", "description": "The node version you are proposing a decision on."},
        "action": {"enum": ["ack", "drop"], "description": "What you propose: `ack` (acknowledge) or `drop`. Only the person decides."},
        "reason": {"$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/longText", "description": "Why you propose this."},
        "source": {"$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/source", "description": "Where the evidence is, such as a file path or a link."}
      }
    },
    "sent": {
      "type": "object",
      "required": ["type", "n"],
      "properties": {
        "type": {"const": "propose"},
        "n": {"$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/nodeRef"},
        "key": {"$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/key"}
      },
      "allOf": [
        {
          "$ref": "https://vision-board.invalid/schema/ledger/16/events/propose.schema.json#/$defs/core"
        }
      ],
      "unevaluatedProperties": false
    },
    "stored": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "propose"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/stamp"},
        {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/stampAgent"
        },
        {
          "$ref": "https://vision-board.invalid/schema/ledger/16/events/propose.schema.json#/$defs/core"
        },
        {
          "type": "object",
          "required": ["n"],
          "properties": {
            "by": {"const": "agent", "description": "Who wrote the line; always `agent` for this event."},
            "n": {"$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/nodeNumber", "description": "The node number."},
            "key": {"$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/key"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
