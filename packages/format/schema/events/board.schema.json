{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/ledger/15/events/board.schema.json",
  "title": "Board event",
  "description": "An agent opens a board, or (from v9) the person creates or renames one. A sent `board` item names no board; the path does.",
  "$comment": "Was: api.md 34, 90",
  "$defs": {
    "core": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {"$ref": "https://vision-board.invalid/schema/ledger/15/common.schema.json#/$defs/title", "description": "The board's title."},
        "summary": {"$ref": "https://vision-board.invalid/schema/ledger/15/common.schema.json#/$defs/summary", "description": "One or two sentences on what the board is for."}
      }
    },
    "rules": {
      "description": "A person's line (from v9): the person created the board, or renamed it, through `put_board`.",
      "$comment": "Kept apart from `core` so a failed rule never hides which fields are known (see common.schema.json `stampAgent`). Was: api.md 90",
      "type": "object",
      "if": {"type": "object", "required": ["by"], "properties": {"by": {"const": "person"}}},
      "then": {"type": "object", "properties": {"v": {"not": {"enum": [2, 3, 4, 5, 6, 7, 8]}}}}
    },
    "sent": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"const": "board"},
        "key": {"$ref": "https://vision-board.invalid/schema/ledger/15/common.schema.json#/$defs/key"}
      },
      "allOf": [
        {
          "$ref": "https://vision-board.invalid/schema/ledger/15/events/board.schema.json#/$defs/core"
        }
      ],
      "unevaluatedProperties": false
    },
    "stored": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "board"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/15/common.schema.json#/$defs/stamp"},
        {
          "$ref": "https://vision-board.invalid/schema/ledger/15/common.schema.json#/$defs/stampAgent"
        },
        {
          "$ref": "https://vision-board.invalid/schema/ledger/15/events/board.schema.json#/$defs/core"
        },
        {"$ref": "https://vision-board.invalid/schema/ledger/15/events/board.schema.json#/$defs/rules"},
        {
          "type": "object",
          "required": ["board"],
          "properties": {
            "by": {"enum": ["agent", "person"], "description": "Who wrote the line: `agent`, or from v9 `person` (put_board)."},
            "board": {"$ref": "https://vision-board.invalid/schema/ledger/15/common.schema.json#/$defs/id", "description": "The board the line belongs to; the server takes it from the path."},
            "key": {"$ref": "https://vision-board.invalid/schema/ledger/15/common.schema.json#/$defs/key"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
