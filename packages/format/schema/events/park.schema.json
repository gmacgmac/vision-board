{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/ledger/3/events/park.schema.json",
  "title": "Ledger v3: the `park` event",
  "description": "The handover bundle written when an item is parked (D-020).",
  "$defs": {
    "core": {
      "type": "object",
      "required": ["bundle"],
      "properties": {
        "bundle": {
          "$ref": "https://vision-board.invalid/schema/ledger/3/events/park.schema.json#/$defs/bundle"
        }
      }
    },
    "sent": {
      "type": "object",
      "required": ["type", "n"],
      "properties": {
        "type": {"const": "park"},
        "n": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/nodeRef"},
        "key": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/key"}
      },
      "allOf": [{"$ref": "https://vision-board.invalid/schema/ledger/3/events/park.schema.json#/$defs/core"}],
      "unevaluatedProperties": false
    },
    "stored": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "park"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/stamp"},
        {
          "$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/stampAgent"
        },
        {"$ref": "https://vision-board.invalid/schema/ledger/3/events/park.schema.json#/$defs/core"},
        {
          "type": "object",
          "required": ["n"],
          "properties": {
            "by": {"const": "agent"},
            "n": {
              "$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/nodeNumber"
            },
            "key": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/key"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "bundle": {
      "type": "object",
      "required": ["situation", "background", "assessment", "recommendation"],
      "properties": {
        "situation": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/longText"},
        "background": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/longText"},
        "assessment": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/longText"},
        "recommendation": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/longText"},
        "sources": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/sources"}
      },
      "unevaluatedProperties": false
    }
  }
}
