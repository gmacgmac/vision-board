{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/ledger/5/events/park.schema.json",
  "title": "Park event",
  "description": "The handover bundle written when an item is parked.",
  "$comment": "Was: D-020",
  "$defs": {
    "core": {
      "type": "object",
      "required": ["bundle"],
      "properties": {
        "bundle": {"$ref": "https://vision-board.invalid/schema/ledger/5/events/park.schema.json#/$defs/bundle", "description": "The handover for an item saved for later, so a new chat can pick it up without this conversation."}
      }
    },
    "sent": {
      "type": "object",
      "required": ["type", "n"],
      "properties": {
        "type": {"const": "park"},
        "n": {"$ref": "https://vision-board.invalid/schema/ledger/5/common.schema.json#/$defs/nodeRef"},
        "key": {"$ref": "https://vision-board.invalid/schema/ledger/5/common.schema.json#/$defs/key"}
      },
      "allOf": [{"$ref": "https://vision-board.invalid/schema/ledger/5/events/park.schema.json#/$defs/core"}],
      "unevaluatedProperties": false
    },
    "stored": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "park"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/5/common.schema.json#/$defs/stamp"},
        {
          "$ref": "https://vision-board.invalid/schema/ledger/5/common.schema.json#/$defs/stampAgent"
        },
        {"$ref": "https://vision-board.invalid/schema/ledger/5/events/park.schema.json#/$defs/core"},
        {
          "type": "object",
          "required": ["n"],
          "properties": {
            "by": {"const": "agent", "description": "Who wrote the line; always `agent` for this event."},
            "n": {"$ref": "https://vision-board.invalid/schema/ledger/5/common.schema.json#/$defs/nodeNumber", "description": "The node number."},
            "key": {"$ref": "https://vision-board.invalid/schema/ledger/5/common.schema.json#/$defs/key"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "bundle": {
      "type": "object",
      "required": ["situation", "background", "assessment", "recommendation"],
      "properties": {
        "situation": {"$ref": "https://vision-board.invalid/schema/ledger/5/common.schema.json#/$defs/longText", "description": "What is going on now."},
        "background": {"$ref": "https://vision-board.invalid/schema/ledger/5/common.schema.json#/$defs/longText", "description": "How things got here."},
        "assessment": {"$ref": "https://vision-board.invalid/schema/ledger/5/common.schema.json#/$defs/longText", "description": "What you make of it."},
        "recommendation": {"$ref": "https://vision-board.invalid/schema/ledger/5/common.schema.json#/$defs/longText", "description": "What you suggest doing next."},
        "sources": {"$ref": "https://vision-board.invalid/schema/ledger/5/common.schema.json#/$defs/sources", "description": "Files or links that back this up."}
      },
      "unevaluatedProperties": false
    }
  }
}
