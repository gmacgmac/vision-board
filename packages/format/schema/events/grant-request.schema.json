{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/ledger/3/events/grant-request.schema.json",
  "title": "Ledger v3: the `grant-request` event",
  "description": "An agent asks the person for write access to one container (api.md 15).",
  "$defs": {
    "core": {
      "type": "object",
      "required": ["board", "region", "reason"],
      "properties": {
        "board": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/id"},
        "region": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/id"},
        "reason": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/longText"}
      }
    },
    "sent": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"const": "grant-request"},
        "key": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/key"}
      },
      "allOf": [
        {
          "$ref": "https://vision-board.invalid/schema/ledger/3/events/grant-request.schema.json#/$defs/core"
        }
      ],
      "unevaluatedProperties": false
    },
    "stored": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "grant-request"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/stamp"},
        {
          "$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/stampAgent"
        },
        {
          "$ref": "https://vision-board.invalid/schema/ledger/3/events/grant-request.schema.json#/$defs/core"
        },
        {
          "type": "object",
          "properties": {
            "by": {"const": "agent"},
            "key": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/key"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
