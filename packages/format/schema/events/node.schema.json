{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/ledger/7/events/node.schema.json",
  "title": "Node event",
  "description": "A new version of node `n`. The server resolves `n`, assigns `ver` and takes the board from the path; a sent item may name `base`, the version it was based on.",
  "$comment": "Was: api.md 6, 30",
  "$defs": {
    "core": {
      "type": "object",
      "required": ["node"],
      "properties": {
        "node": {"$ref": "https://vision-board.invalid/schema/ledger/7/events/node.schema.json#/$defs/body", "description": "The content of this version of the node."}
      }
    },
    "sent": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"const": "node"},
        "n": {"$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/nodeRef"},
        "base": {"$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/version", "description": "The `ver` you read. If the node has moved on since, the item fails with `conflict`."},
        "key": {"$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/key"}
      },
      "allOf": [{"$ref": "https://vision-board.invalid/schema/ledger/7/events/node.schema.json#/$defs/core"}],
      "unevaluatedProperties": false
    },
    "stored": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "node"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/stamp"},
        {
          "$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/stampAgent"
        },
        {"$ref": "https://vision-board.invalid/schema/ledger/7/events/node.schema.json#/$defs/core"},
        {
          "type": "object",
          "required": ["board", "n", "ver"],
          "properties": {
            "by": {"const": "agent", "description": "Who wrote the line; always `agent` for this event."},
            "board": {"$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/id", "description": "The board the line belongs to; the server takes it from the path."},
            "n": {"$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/nodeNumber", "description": "The node number."},
            "ver": {"$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/version", "description": "The node version this line wrote."},
            "key": {"$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/key"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "body": {
      "type": "object",
      "required": ["region", "kind", "title"],
      "properties": {
        "region": {"$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/id", "description": "The container (region) the node sits in."},
        "kind": {"$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/kind", "description": "What the node is: `question`, `finding`, `decision`, `risk`, `action`, `topic` or `note`."},
        "title": {"$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/title", "description": "The node's title."},
        "body": {"$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/nodeBody", "description": "The node's text."},
        "item": {"type": "boolean", "description": "True when the node asks the person for a response; it then gets an item number."},
        "lane": {"$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/lane", "description": "The lane the node sits in, for a container in `lanes` mode."},
        "tags": {"$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/tags", "description": "Short labels for the node."},
        "emphasis": {"type": "boolean", "description": "True to draw the node emphasised. It never overrides a size the person chose."},
        "size": {
          "$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/nodeSize",
          "description": "The agent's suggestion; the person's size wins",
          "$comment": "Was: api.md 17"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
