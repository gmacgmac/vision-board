{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/ledger/6/events/seen.schema.json",
  "title": "Seen event",
  "description": "The person has seen version `ver` of node `n`.",
  "$comment": "Was: D-018",
  "$defs": {
    "core": {
      "type": "object",
      "required": ["n", "ver"],
      "properties": {
        "n": {"$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/nodeNumber", "description": "The number of the node the person has seen."},
        "ver": {"$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/version", "description": "The version of that node the person has seen."}
      }
    },
    "sent": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "seen"}},
      "allOf": [{"$ref": "https://vision-board.invalid/schema/ledger/6/events/seen.schema.json#/$defs/core"}],
      "unevaluatedProperties": false
    },
    "stored": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "seen"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/stamp"},
        {
          "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/stampAgent"
        },
        {"$ref": "https://vision-board.invalid/schema/ledger/6/events/seen.schema.json#/$defs/core"},
        {"type": "object", "properties": {"by": {"const": "person", "description": "Who wrote the line; always `person` for this event."}}}
      ],
      "unevaluatedProperties": false
    }
  }
}
