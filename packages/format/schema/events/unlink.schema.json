{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/ledger/15/events/unlink.schema.json",
  "title": "Unlink event",
  "description": "An agent removes a link. `from` and `to` take a number or `{ key }` when sent.",
  "$comment": "Was: api.md 35",
  "$defs": {
    "core": {"$ref": "https://vision-board.invalid/schema/ledger/15/events/link.schema.json#/$defs/core"},
    "sent": {
      "type": "object",
      "required": ["type", "from", "to"],
      "properties": {
        "type": {"const": "unlink"},
        "from": {"$ref": "https://vision-board.invalid/schema/ledger/15/common.schema.json#/$defs/nodeRef"},
        "to": {"$ref": "https://vision-board.invalid/schema/ledger/15/common.schema.json#/$defs/nodeRef"},
        "key": {"$ref": "https://vision-board.invalid/schema/ledger/15/common.schema.json#/$defs/key"}
      },
      "allOf": [
        {
          "$ref": "https://vision-board.invalid/schema/ledger/15/events/unlink.schema.json#/$defs/core"
        }
      ],
      "unevaluatedProperties": false
    },
    "stored": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "unlink"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/15/common.schema.json#/$defs/stamp"},
        {
          "$ref": "https://vision-board.invalid/schema/ledger/15/common.schema.json#/$defs/stampAgent"
        },
        {
          "$ref": "https://vision-board.invalid/schema/ledger/15/events/unlink.schema.json#/$defs/core"
        },
        {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "by": {"const": "agent", "description": "Who wrote the line; always `agent` for this event."},
            "from": {"$ref": "https://vision-board.invalid/schema/ledger/15/common.schema.json#/$defs/nodeNumber", "description": "The node the link starts at."},
            "to": {"$ref": "https://vision-board.invalid/schema/ledger/15/common.schema.json#/$defs/nodeNumber", "description": "The node the link ends at."},
            "key": {"$ref": "https://vision-board.invalid/schema/ledger/15/common.schema.json#/$defs/key"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
