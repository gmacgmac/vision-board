{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/ledger/3/events/join.schema.json",
  "title": "Ledger v3: the `join` event",
  "description": "An agent joins the project with a label; its stamped `agent` is the new agent id (api.md 14, 21).",
  "$defs": {
    "core": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": {
          "$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/agentLabel"
        }
      }
    },
    "sent": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"const": "join"},
        "key": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/key"}
      },
      "allOf": [{"$ref": "https://vision-board.invalid/schema/ledger/3/events/join.schema.json#/$defs/core"}],
      "unevaluatedProperties": false
    },
    "stored": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "join"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/stamp"},
        {
          "$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/stampAgent"
        },
        {"$ref": "https://vision-board.invalid/schema/ledger/3/events/join.schema.json#/$defs/core"},
        {
          "type": "object",
          "required": ["agent"],
          "properties": {
            "by": {"const": "agent"},
            "agent": {
              "$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/agentId"
            },
            "key": {"$ref": "https://vision-board.invalid/schema/ledger/3/common.schema.json#/$defs/key"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
