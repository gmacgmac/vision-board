{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/ledger/18/events/join.schema.json",
  "title": "Join event",
  "description": "An agent joins the project with a label; its stamped `agent` is the new agent id.",
  "$comment": "Was: api.md 14, 21",
  "$defs": {
    "core": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": {"$ref": "https://vision-board.invalid/schema/ledger/18/common.schema.json#/$defs/agentLabel", "description": "The agent's working folder's name (not a path); the person sees it when you ask for access."}
      }
    },
    "sent": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"const": "join"}
      },
      "allOf": [{"$ref": "https://vision-board.invalid/schema/ledger/18/events/join.schema.json#/$defs/core"}],
      "unevaluatedProperties": false
    },
    "stored": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "join"}},
      "allOf": [
        {"$ref": "https://vision-board.invalid/schema/ledger/18/common.schema.json#/$defs/stamp"},
        {
          "$ref": "https://vision-board.invalid/schema/ledger/18/common.schema.json#/$defs/stampAgent"
        },
        {"$ref": "https://vision-board.invalid/schema/ledger/18/events/join.schema.json#/$defs/core"},
        {
          "type": "object",
          "required": ["agent"],
          "properties": {
            "by": {"const": "agent", "description": "Who wrote the line; always `agent` for this event."},
            "agent": {"$ref": "https://vision-board.invalid/schema/ledger/18/common.schema.json#/$defs/agentId", "description": "The new agent id."}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
