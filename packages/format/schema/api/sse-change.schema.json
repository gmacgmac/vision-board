{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/api/sse-change.schema.json",
  "title": "Board change event",
  "description": "A `change` event whose `data` is JSON `{ seq }`.",
  "$comment": "Was: api.md 44; OpenAPI 3.2.1 4.14.4",
  "type": "object",
  "required": [
    "event",
    "data"
  ],
  "properties": {
    "event": {
      "const": "change",
      "description": "The event name; always `change`."
    },
    "data": {
      "type": "string",
      "contentMediaType": "application/json",
      "contentSchema": {
        "type": "object",
        "required": [
          "seq"
        ],
        "properties": {
          "seq": {
            "$ref": "https://vision-board.invalid/schema/ledger/5/common.schema.json#/$defs/seq"
          }
        },
        "unevaluatedProperties": false
      },
      "description": "JSON text `{ \"seq\": <ledger position> }`: the ledger position just reached."
    },
    "retry": {
      "type": "integer",
      "minimum": 0,
      "description": "How many milliseconds a client waits before it reconnects."
    }
  },
  "unevaluatedProperties": false
}
