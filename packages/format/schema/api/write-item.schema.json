{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/api/write-item.schema.json",
  "title": "Write item",
  "description": "One item, by `type`. Each is checked on its own, so a bad item fails alone. No `board`: the call names it.",
  "$comment": "Was: api.md 24, 34, 95, 126, 147",
  "type": "object",
  "required": [
    "type"
  ],
  "discriminator": {
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "https://vision-board.invalid/schema/ledger/18/events/board.schema.json#/$defs/sent"
    },
    {
      "$ref": "https://vision-board.invalid/schema/ledger/18/events/region.schema.json#/$defs/sent"
    },
    {
      "$ref": "https://vision-board.invalid/schema/ledger/18/events/node.schema.json#/$defs/sent"
    },
    {
      "$ref": "https://vision-board.invalid/schema/ledger/18/events/link.schema.json#/$defs/sent"
    },
    {
      "$ref": "https://vision-board.invalid/schema/ledger/18/events/unlink.schema.json#/$defs/sent"
    },
    {
      "$ref": "https://vision-board.invalid/schema/ledger/18/events/reply.schema.json#/$defs/sent"
    },
    {
      "title": "Propose",
      "description": "Propose the person's ✓ or ✗ on version `ver` of card `n`; only the person answers. The old `ack` and `drop` are refused.",
      "$comment": "Was: D-018, api.md 147 (D-045)",
      "examples": [{"type": "propose", "key": "fee-propose", "n": 1, "ver": 1, "action": "check", "reason": "The cost model supports it."}],
      "type": "object",
      "required": ["type", "n", "ver", "action", "reason"],
      "properties": {
        "type": {"const": "propose"},
        "n": {"$ref": "https://vision-board.invalid/schema/ledger/18/common.schema.json#/$defs/nodeRef"},
        "ver": {"$ref": "https://vision-board.invalid/schema/ledger/18/common.schema.json#/$defs/version", "description": "The card version you propose on."},
        "action": {"enum": ["check", "cross"], "description": "✓ `check` or ✗ `cross`."},
        "reason": {"$ref": "https://vision-board.invalid/schema/ledger/18/common.schema.json#/$defs/longText", "description": "Why you propose this."},
        "source": {"$ref": "https://vision-board.invalid/schema/ledger/18/common.schema.json#/$defs/source", "description": "Where the evidence is, such as a file path or a link."},
        "key": {"$ref": "https://vision-board.invalid/schema/ledger/18/common.schema.json#/$defs/key"}
      },
      "unevaluatedProperties": false
    },
    {
      "$ref": "https://vision-board.invalid/schema/ledger/18/events/park.schema.json#/$defs/sent"
    },
    {
      "$ref": "https://vision-board.invalid/schema/ledger/18/events/retire.schema.json#/$defs/sent"
    },
    {
      "title": "Append",
      "description": "Add `text` to the end of card `n`'s body, after a blank line, as a new version; nothing else changes.",
      "examples": [{"type": "append", "key": "fee-append", "n": 1, "text": "Update: seats are billed monthly."}],
      "type": "object",
      "required": ["type", "n", "text"],
      "properties": {
        "type": {"const": "append"},
        "n": {"$ref": "https://vision-board.invalid/schema/ledger/18/common.schema.json#/$defs/nodeRef"},
        "text": {"$ref": "https://vision-board.invalid/schema/ledger/18/common.schema.json#/$defs/nodeBody", "description": "The text to add; the body with it must still fit its limit."},
        "base": {"$ref": "https://vision-board.invalid/schema/ledger/18/common.schema.json#/$defs/version", "description": "The `ver` you read; if the card has moved on, the item fails with `conflict`."},
        "key": {"$ref": "https://vision-board.invalid/schema/ledger/18/common.schema.json#/$defs/key"}
      },
      "unevaluatedProperties": false
    }
  ]
}
