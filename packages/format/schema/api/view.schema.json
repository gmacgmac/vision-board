{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/api/view.schema.json",
  "title": "Board view",
  "description": "One board as the page draws it: meaning only, no coordinates. A node's id is the string form of its number; `n` is set only on items.",
  "$comment": "The View the layout engine and the page read (packages/format `View`, `boardView`).",
  "type": "object",
  "required": [
    "format",
    "session",
    "version",
    "title",
    "regions",
    "nodes",
    "links"
  ],
  "properties": {
    "format": {
      "const": 1,
      "description": "The View format version; always 1."
    },
    "session": {
      "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/id",
      "description": "The board id"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "description": "The ledger position the view was folded at"
    },
    "title": {
      "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/title",
      "description": "The board's title."
    },
    "summary": {
      "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/summary",
      "description": "What the board is for."
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "https://vision-board.invalid/schema/api/view.schema.json#/$defs/region"
      },
      "description": "The containers on the board."
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "https://vision-board.invalid/schema/api/view.schema.json#/$defs/node"
      },
      "description": "Every node on the board, in its latest version."
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "https://vision-board.invalid/schema/api/view.schema.json#/$defs/link"
      },
      "description": "The links between nodes."
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "region": {
      "type": "object",
      "required": [
        "id",
        "title",
        "mode"
      ],
      "properties": {
        "id": {
          "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/id",
          "description": "The container's id."
        },
        "title": {
          "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/regionTitle",
          "description": "The container's title."
        },
        "mode": {
          "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/mode",
          "description": "How the container lays out its cards."
        },
        "lanes": {
          "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/lanes",
          "description": "Lane names, top to bottom, for a container in `lanes` mode."
        },
        "columns": {
          "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/columns",
          "description": "How many columns a `grid` container uses."
        },
        "center": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/nodeId",
          "description": "The centre node's id (the ledger writes its number)",
          "$comment": "Was: api.md 18"
        }
      },
      "unevaluatedProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "region",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/nodeId"
        },
        "region": {
          "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/id",
          "description": "The container the node sits in."
        },
        "kind": {
          "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/kind",
          "description": "What the node is: a question, finding, decision, risk, action, topic or note."
        },
        "title": {
          "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/title",
          "description": "The node's title."
        },
        "body": {
          "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/nodeBody",
          "description": "The node's text."
        },
        "n": {
          "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/nodeNumber",
          "description": "The item number; present when the node asks the person for a response."
        },
        "lane": {
          "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/lane",
          "description": "The lane the node sits in, for a container in `lanes` mode."
        },
        "tags": {
          "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/tags",
          "description": "Short labels for the node."
        },
        "emphasis": {
          "type": "boolean",
          "description": "True when the agent drew the node emphasised."
        },
        "size": {
          "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/nodeSize",
          "description": "The agent's size suggestion; the person's choice is in `state.sizes`."
        }
      },
      "unevaluatedProperties": false
    },
    "link": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/nodeId"
        },
        "to": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/nodeId"
        },
        "label": {
          "$ref": "https://vision-board.invalid/schema/ledger/6/common.schema.json#/$defs/linkLabel",
          "description": "What the link means, in a few words."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
