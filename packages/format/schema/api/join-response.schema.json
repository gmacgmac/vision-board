{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/api/join-response.schema.json",
  "title": "Join answer",
  "description": "The agent id and its secret, shown once. The agent must save both in its durable notes.",
  "$comment": "Was: api.md 21; api.md 22",
  "type": "object",
  "required": [
    "agent",
    "secret",
    "project"
  ],
  "properties": {
    "agent": {
      "$ref": "https://vision-board.invalid/schema/ledger/18/common.schema.json#/$defs/agentId",
      "description": "Your agent id."
    },
    "secret": {
      "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/secret"
    },
    "project": {
      "$ref": "https://vision-board.invalid/schema/api/project.schema.json#/$defs/displayName",
      "description": "The folder the board server has open, as the person reads it (`~/projects/example`): check it is the folder you work in."
    }
  },
  "unevaluatedProperties": false
}
