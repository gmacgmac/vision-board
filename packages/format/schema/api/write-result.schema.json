{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/api/write-result.schema.json",
  "title": "Write results",
  "description": "A batch that can be read always answers 200, with one result per item, in order, plus `head` and `pending`.",
  "$comment": "Was: api.md 34, 36",
  "type": "object",
  "required": [
    "results",
    "head",
    "pending"
  ],
  "properties": {
    "results": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "oneOf": [
          {
            "$ref": "https://vision-board.invalid/schema/api/write-result.schema.json#/$defs/written"
          },
          {
            "$ref": "https://vision-board.invalid/schema/api/write-result.schema.json#/$defs/failed"
          }
        ]
      },
      "description": "One result per item, in the order you sent them."
    },
    "head": {
      "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/head"
    },
    "pending": {
      "type": "array",
      "items": {
        "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/openItem"
      },
      "description": "Cards of any kind in containers the caller holds that still wait for it"
    },
    "containers": {
      "type": "array",
      "items": {
        "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/openContainer"
      },
      "description": "Whole containers the caller holds whose latest note still waits for it; left out when none.",
      "$comment": "Was: api.md 77"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "written": {
      "type": "object",
      "required": [
        "index",
        "ok",
        "seq"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 199,
          "description": "The position of the item in your request, from 0."
        },
        "key": {
          "$ref": "https://vision-board.invalid/schema/ledger/19/common.schema.json#/$defs/key"
        },
        "ok": {
          "const": true,
          "description": "True: the item was written."
        },
        "seq": {
          "$ref": "https://vision-board.invalid/schema/ledger/19/common.schema.json#/$defs/seq",
          "description": "The ledger line the item was written as."
        },
        "n": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/cardNumber",
          "description": "The card's number on this board, for a `node` or `append` item"
        },
        "ver": {
          "$ref": "https://vision-board.invalid/schema/ledger/19/common.schema.json#/$defs/version",
          "description": "The new version, for a `node` item"
        },
        "title": {
          "$ref": "https://vision-board.invalid/schema/ledger/19/common.schema.json#/$defs/title",
          "description": "The node's title as written, for a `node` item: check it names the node you meant",
          "$comment": "Was: api.md 34"
        },
        "retired": {
          "type": "array",
          "maxItems": 500,
          "items": {"$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/cardNumber"},
          "description": "For a `retire` item: every card it took off the board, by number (none for an empty container)",
          "$comment": "Was: api.md 126"
        },
        "inserted": {
          "type": "object",
          "required": ["after", "before"],
          "properties": {
            "after": {"$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/cardNumber", "description": "The card that now links to this one."},
            "before": {"$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/cardNumber", "description": "The card this one now links to."}
          },
          "additionalProperties": false,
          "description": "For a `node` item with `insert`: the two cards it now sits between, by number; their old link is gone",
          "$comment": "Was: api.md 174"
        },
        "replayed": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/more",
          "description": "The key was sent before with the same content; nothing was written now",
          "$comment": "Was: api.md 29"
        },
        "images": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["path", "problem"],
            "properties": {
              "path": {"type": "string", "maxLength": 2048, "description": "The picture's path as the card's Markdown names it."},
              "problem": {"type": "string", "maxLength": 500, "description": "Why the board can't show it."}
            },
            "additionalProperties": false
          },
          "description": "Pictures in this card's text the board can't show (no such file in `images/`, or a path it refuses), each with why; left out when every picture shows. Save the file there, or rewrite the card with a path that starts inside `images/`.",
          "$comment": "With the botToolRules flag on."
        }
      },
      "unevaluatedProperties": false
    },
    "failed": {
      "type": "object",
      "required": [
        "index",
        "ok",
        "problem"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 199,
          "description": "The position of the item in your request, from 0."
        },
        "key": {
          "$ref": "https://vision-board.invalid/schema/ledger/19/common.schema.json#/$defs/key"
        },
        "ok": {
          "const": false,
          "description": "False: the item was not written; `problem` says why."
        },
        "problem": {
          "$ref": "https://vision-board.invalid/schema/api/problem.schema.json#/$defs/item"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
