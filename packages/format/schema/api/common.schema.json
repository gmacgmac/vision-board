{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/api/common.schema.json",
  "title": "Shared API definitions",
  "description": "Cursors, limits and the response parts more than one operation returns. Ledger values (ids, text, limits, enums) come from the ledger schemas.",
  "$comment": "Was: api.md 31, 36",
  "$defs": {
    "cardNumber": {
      "type": "integer",
      "minimum": 1,
      "description": "A card's number on the board the operation names: 1, 2, 3... in the order its cards were drawn, never given again on that board",
      "$comment": "Was: api.md 125, D-041"
    },
    "cardNumbers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {"$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/cardNumber"},
      "description": "Two or more distinct cards on the board, by number, each once",
      "$comment": "Was: api.md 62, 125"
    },
    "head": {
      "type": "integer",
      "minimum": 0,
      "description": "The ledger's latest `seq`; 0 when it is empty",
      "$comment": "Was: api.md 31"
    },
    "after": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "A `seq`; 0 means from the start",
      "$comment": "Was: api.md 31"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 100,
      "description": "How many to return at most",
      "$comment": "Was: api.md 31"
    },
    "wait": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60,
      "default": 0,
      "description": "Seconds to hold the call until the person acts; 0 answers at once"
    },
    "linked": {
      "type": "boolean",
      "default": false,
      "description": "True adds the nodes linked to this one"
    },
    "more": {
      "const": true,
      "description": "Present, and true, only when there is more to read or the answer repeats an earlier one"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "description": "A node as the View names it: the string form of its number"
    },
    "itemStatus": {
      "enum": [
        "open",
        "acknowledged",
        "dropped",
        "commented",
        "context",
        "later"
      ]
    },
    "pendingReason": {
      "enum": [
        "comment",
        "context",
        "later"
      ],
      "description": "Why a card of any kind waits for the agent: a comment or a \"needs context\" with no answer yet, or moved to Later with no park bundle",
      "$comment": "Was: api.md 36, 120"
    },
    "secret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "32 random bytes, base64url, shown once",
      "$comment": "Was: api.md 21"
    },
    "note": {
      "type": "object",
      "description": "One of the person's notes as it stands now: its latest text and kind. A removed note is left out.",
      "$comment": "Was: api.md 58-61",
      "required": [
        "seq",
        "kind",
        "text",
        "at"
      ],
      "properties": {
        "seq": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/seq",
          "description": "The `seq` of the `comment` or `context` act that made the note; `note-edit`, `note-remove` and a `reply`'s `to` name it by this."
        },
        "kind": {
          "enum": [
            "comment",
            "context"
          ],
          "description": "`comment` or `context` (a request for more context)."
        },
        "text": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/longText",
          "description": "The person's words."
        },
        "at": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/timestamp",
          "description": "When the person wrote it."
        },
        "sent": {
          "const": true,
          "description": "The person has pressed Send since writing it, so it is history and can no longer be edited or removed"
        },
        "locked": {
          "const": true,
          "description": "The note is history and can no longer be edited or removed: the person has pressed Send since writing it (`sent`), or the agent has answered it (a reply naming it in `to`, or a newer version of one of its cards)"
        },
        "nodes": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/cardNumbers",
          "description": "For a note on a group of cards: every item it is on. Left out for a note on one card."
        }
      },
      "unevaluatedProperties": false
    },
    "itemState": {
      "type": "object",
      "description": "The person's answers on one item",
      "required": [
        "status",
        "notes"
      ],
      "properties": {
        "status": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/itemStatus"
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/note"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "reply": {
      "type": "object",
      "required": [
        "seq",
        "at",
        "text"
      ],
      "properties": {
        "seq": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/seq",
          "description": "The reply's ledger line."
        },
        "at": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/timestamp",
          "description": "When the agent replied."
        },
        "text": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/longText",
          "description": "The agent's answer."
        },
        "to": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/seq",
          "description": "The `seq` of the person's action this answers."
        },
        "agent": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/text",
          "description": "The agent that replied."
        }
      },
      "unevaluatedProperties": false
    },
    "proposal": {
      "type": "object",
      "description": "An agent's proposed decision; `decidedBy` is the `seq` of the person's act that ended it, and `outcome` how",
      "$comment": "Was: api.md 93",
      "required": [
        "seq",
        "at",
        "n",
        "ver",
        "action",
        "reason"
      ],
      "properties": {
        "seq": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/seq",
          "description": "The proposal's ledger line."
        },
        "at": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/timestamp",
          "description": "When the agent proposed it."
        },
        "n": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/cardNumber",
          "description": "The card the proposal is about, by its number on the board."
        },
        "ver": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/version",
          "description": "The node version the proposal is about."
        },
        "action": {
          "enum": [
            "ack",
            "drop"
          ],
          "description": "`ack` (acknowledge) or `drop`."
        },
        "reason": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/longText",
          "description": "Why the agent proposed it."
        },
        "source": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/source",
          "description": "Where the evidence is."
        },
        "agent": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/text",
          "description": "The agent that proposed it."
        },
        "decidedBy": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/seq",
          "description": "The `seq` of the person's action that ended it; absent while it waits."
        },
        "outcome": {
          "enum": [
            "accepted",
            "rejected",
            "closed"
          ],
          "description": "How it ended, with `decidedBy`: `accepted` (the person took it), `rejected` (turned down), or `closed` (the person acknowledged or dropped the item another way)."
        }
      },
      "dependentRequired": {
        "outcome": ["decidedBy"],
        "decidedBy": ["outcome"]
      },
      "unevaluatedProperties": false
    },
    "link": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/cardNumber",
          "description": "The card the link starts at, by its number on the board."
        },
        "to": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/cardNumber",
          "description": "The card the link ends at, by its number on the board."
        },
        "label": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/linkLabel",
          "description": "What the link means, in a few words."
        }
      },
      "unevaluatedProperties": false
    },
    "nodeVersion": {
      "type": "object",
      "description": "One version of a node: what the agent said, when, and who",
      "required": [
        "ver",
        "at",
        "node"
      ],
      "properties": {
        "ver": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/version",
          "description": "The version number, from 1."
        },
        "at": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/timestamp",
          "description": "When this version was written."
        },
        "agent": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/text",
          "description": "The agent that wrote this version."
        },
        "node": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/events/node.schema.json#/$defs/body",
          "description": "What the agent said in this version."
        }
      },
      "unevaluatedProperties": false
    },
    "nodeDetailCore": {
      "type": "object",
      "description": "Everything known about one node.",
      "$comment": "Left open so show_node can add `head` and `linked`. Was: api.md 6",
      "required": [
        "n",
        "board",
        "region",
        "status",
        "versions",
        "notes",
        "replies",
        "proposals",
        "links"
      ],
      "properties": {
        "n": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/cardNumber",
          "description": "The card's number on its board."
        },
        "board": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/id",
          "description": "The board the node is on."
        },
        "region": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/id",
          "description": "The container the node is in now."
        },
        "moved_from": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/id",
          "description": "The region the agent drew the node in, when the person moved it to `region`; left out when it is where the agent drew it",
          "$comment": "Was: api.md 68"
        },
        "status": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/itemStatus",
          "description": "Where the card stands with the person; every card has one. Only a question, decision or action is decided (acknowledged, dropped or commented).",
          "$comment": "Was: api.md 118, 120"
        },
        "size": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/nodeSize",
          "description": "The person's size; it wins over the agent's suggestion in `versions`",
          "$comment": "Was: api.md 17"
        },
        "seen": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/version",
          "description": "The latest version the person has seen"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/nodeVersion"
          },
          "description": "Every version of the node, oldest first."
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/note"
          },
          "description": "The person's comments and requests for context on the node."
        },
        "replies": {
          "type": "array",
          "items": {
            "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/reply"
          },
          "description": "The agent's replies on the node."
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/proposal"
          },
          "description": "The agent's proposed decisions on the node."
        },
        "park": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/events/park.schema.json#/$defs/bundle",
          "description": "The handover bundle, when the node has been saved for later."
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/link"
          },
          "description": "Links from or to this node"
        },
        "retired": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/seq",
          "description": "The ledger line that took the card off the board, for a retired card; left out while it is on the board. Its history stays readable and its number is never given again.",
          "$comment": "Was: api.md 126"
        }
      }
    },
    "nodeDetail": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/nodeDetailCore"
        }
      ],
      "unevaluatedProperties": false
    },
    "openItem": {
      "type": "object",
      "description": "An open card: a question, decision or action not yet decided, or a card of any kind that waits for the agent (`pending`). `pending` and `unseen` are left out when they do not apply",
      "$comment": "Was: api.md 32, 120",
      "required": [
        "board",
        "n",
        "ver",
        "region",
        "kind",
        "title",
        "status"
      ],
      "properties": {
        "board": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/id",
          "description": "The board the item is on."
        },
        "n": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/cardNumber",
          "description": "The card's number on its board."
        },
        "ver": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/version",
          "description": "The item's latest version."
        },
        "region": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/id",
          "description": "The container the item is in."
        },
        "moved_from": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/id",
          "description": "The region the agent drew the item in, when the person moved it to `region`; left out when it is where the agent drew it",
          "$comment": "Was: api.md 68"
        },
        "kind": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/kind",
          "description": "What the node is."
        },
        "title": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/title",
          "description": "The item's title."
        },
        "status": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/itemStatus",
          "description": "Where the card stands with the person."
        },
        "pending": {
          "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/pendingReason"
        },
        "unseen": {
          "const": true,
          "description": "The item has a newer version than the person last saw"
        }
      },
      "unevaluatedProperties": false
    },
    "openContainer": {
      "type": "object",
      "description": "A whole container whose latest note from the person has no answer yet. Answer it with a `reply` whose `to` is `note`.",
      "$comment": "Was: api.md 73, 77",
      "required": ["board", "region", "title", "pending", "note"],
      "properties": {
        "board": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/id",
          "description": "The board the container is on."
        },
        "region": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/id",
          "description": "The container."
        },
        "title": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/title",
          "description": "The container's title."
        },
        "pending": {
          "enum": ["comment", "context"],
          "description": "What the note asks for: a comment, or more context."
        },
        "note": {
          "$ref": "https://vision-board.invalid/schema/ledger/16/common.schema.json#/$defs/seq",
          "description": "The `seq` of the note waiting for an answer."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
