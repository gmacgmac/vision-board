{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/api/list-icons-response.schema.json",
  "title": "Icons",
  "description": "The icons a node may name: the built-in set, and the project's library (`.visionboard/icons/`, shared by every board of the project), each checked as it is read.",
  "$comment": "Was: api.md 186, D-100 3; packages/format ICON_NAMES",
  "type": "object",
  "required": [
    "builtIn",
    "library"
  ],
  "properties": {
    "builtIn": {
      "type": "array",
      "items": {
        "$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/iconName"
      },
      "description": "The built-in icons, by name."
    },
    "library": {
      "type": "array",
      "items": {
        "$ref": "https://vision-board.invalid/schema/api/list-icons-response.schema.json#/$defs/icon"
      },
      "description": "The project's library icons, by name, each checked as it is read: every file in the folder that passes, including one this ledger has no `icon` line for yet (its first use writes one); reuse one before you add one."
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "https://vision-board.invalid/schema/api/list-icons-response.schema.json#/$defs/problem"
      },
      "description": "What is wrong with a library icon: its file is missing, fails the check, or no longer matches its hash (a node naming it draws a plain tile). Left out when there is none."
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "icon": {
      "type": "object",
      "required": [
        "name",
        "title"
      ],
      "properties": {
        "name": {
          "$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/libraryIconName",
          "description": "The icon's name, as a node names it."
        },
        "title": {
          "$ref": "https://vision-board.invalid/schema/api/add-icon-request.schema.json#/$defs/title",
          "description": "A few words saying what it shows."
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "description": "With `paths=true` only: the drawing's checked path data, one `d` string per path, for the page to draw."
        }
      },
      "unevaluatedProperties": false
    },
    "problem": {
      "type": "object",
      "required": [
        "name",
        "detail"
      ],
      "properties": {
        "name": {
          "$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/libraryIconName",
          "description": "The icon."
        },
        "detail": {
          "$ref": "https://vision-board.invalid/schema/ledger/22/common.schema.json#/$defs/text",
          "description": "What is wrong, in plain words."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
