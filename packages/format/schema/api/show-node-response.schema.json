{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/api/show-node-response.schema.json",
  "title": "API: show_node answer",
  "description": "Every version of a node with its notes, replies, proposals, park bundle, links, region and size; `linked` (only with `linked=true`) holds the nodes linked to it, one hop.",
  "type": "object",
  "required": [
    "head"
  ],
  "properties": {
    "head": {
      "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/head"
    },
    "linked": {
      "type": "array",
      "items": {
        "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/nodeDetail"
      }
    }
  },
  "allOf": [
    {
      "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/nodeDetailCore"
    }
  ],
  "unevaluatedProperties": false
}
