{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/api/get-board-response.schema.json",
  "title": "Board state",
  "description": "The board now: the View, the person's answers for every node, every node's latest version, and `head`; with agents, also the open grant requests, the board's holders and each region's holders. `state` and `versions` are keyed by node id (the string form of the number).",
  "type": "object",
  "required": [
    "head",
    "view",
    "state",
    "versions"
  ],
  "properties": {
    "head": {
      "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/head"
    },
    "view": {
      "$ref": "https://vision-board.invalid/schema/api/view.schema.json"
    },
    "state": {
      "type": "object",
      "required": [
        "items",
        "pins",
        "modes"
      ],
      "properties": {
        "items": {
          "type": "object",
          "propertyNames": {
            "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/nodeId"
          },
          "additionalProperties": {
            "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/itemState"
          },
          "description": "Each item's status and the person's notes, by node id."
        },
        "pins": {
          "type": "object",
          "propertyNames": {
            "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/nodeId"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "unevaluatedProperties": false
          },
          "description": "Where the person pinned nodes, by node id."
        },
        "modes": {
          "type": "object",
          "propertyNames": {
            "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/mode"
          },
          "description": "Region id to the person's layout choice"
        },
        "sizes": {
          "type": "object",
          "propertyNames": {
            "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/nodeId"
          },
          "additionalProperties": {
            "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/nodeSize"
          },
          "description": "The person's size per node; left out when none is set",
          "$comment": "Was: api.md 17"
        },
        "moves": {
          "type": "object",
          "propertyNames": {
            "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/nodeId"
          },
          "additionalProperties": {
            "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/id"
          },
          "description": "The container the person put a node in, by node id, for each node not in the region the agent drew it in (`later` is the board's built-in Later); left out when none is moved. It wins over the node's region in `view`, as a pin wins over the layout.",
          "$comment": "Was: api.md 68"
        },
        "containerNotes": {
          "type": "object",
          "propertyNames": {
            "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/id"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/note"
            }
          },
          "description": "The person's notes on a whole container, by region id, oldest first; a removed note is left out, and so is the key when the board has none.",
          "$comment": "Was: api.md 73, 75"
        },
        "containerPins": {
          "type": "object",
          "propertyNames": {
            "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": {"type": "number", "description": "Across, in board coordinates."},
              "y": {"type": "number", "description": "Down, in board coordinates."}
            },
            "unevaluatedProperties": false
          },
          "description": "Where the person placed a container, by region id (`later` included): its frame's top-left in board coordinates; left out when none is placed.",
          "$comment": "Was: api.md 74, 75"
        }
      },
      "unevaluatedProperties": false,
      "description": "What the person has done on this board: each item's status, pins, chosen layout modes, sizes and moves, and the notes on and places of whole containers."
    },
    "versions": {
      "type": "object",
      "propertyNames": {
        "$ref": "https://vision-board.invalid/schema/api/common.schema.json#/$defs/nodeId"
      },
      "additionalProperties": {
        "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/version"
      },
      "description": "Each node's latest version number, by node id."
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "description": "The grant requests on this board the person has not answered, oldest first; left out when there are none. The person answers one with `grant` or `deny` and its `seq`.",
      "$comment": "Was: api.md 26, 32",
      "items": {
        "type": "object",
        "required": [
          "seq",
          "reason",
          "at"
        ],
        "properties": {
          "seq": {
            "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/seq",
            "description": "The request's `seq`; the person answers it with `grant` or `deny`."
          },
          "region": {
            "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/id",
            "description": "The container the agent asked for; left out when it asked for the whole board."
          },
          "reason": {
            "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/longText",
            "description": "Why the agent asked."
          },
          "at": {
            "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/timestamp",
            "description": "When the agent asked."
          },
          "agent": {
            "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/agentId",
            "description": "The agent that asked."
          },
          "label": {
            "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/agentLabel",
            "description": "The label the asking agent joined with"
          }
        },
        "unevaluatedProperties": false
      }
    },
    "boardHolders": {
      "type": "array",
      "minItems": 1,
      "description": "The agents that may write on this board now, creator first; left out when there are none.",
      "$comment": "Was: api.md 81, 82; api.md 32",
      "items": {
        "$ref": "https://vision-board.invalid/schema/api/get-board-response.schema.json#/$defs/holder"
      }
    },
    "holders": {
      "type": "object",
      "description": "Region id to the agents that hold it now, creator first; a region with none, and a board with none, are left out.",
      "$comment": "Was: api.md 23; api.md 32",
      "propertyNames": {
        "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "https://vision-board.invalid/schema/api/get-board-response.schema.json#/$defs/holder"
        }
      }
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "holder": {
      "type": "object",
      "description": "One agent that holds the board or a region, with the label it joined with.",
      "required": [
        "agent",
        "label"
      ],
      "properties": {
        "agent": {
          "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/agentId",
          "description": "The holder's agent id."
        },
        "label": {
          "$ref": "https://vision-board.invalid/schema/ledger/10/common.schema.json#/$defs/agentLabel",
          "description": "The label the holder joined with."
        },
        "creator": {
          "const": true,
          "description": "Present, and true, for the agent that created the board or region; the person cannot remove it"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
