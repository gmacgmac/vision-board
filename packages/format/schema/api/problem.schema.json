{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/api/problem.schema.json",
  "title": "Problem details",
  "description": "Every error is `application/problem+json`. `$defs/item` is the same object without `status`, for a failed write item, because the response's own status is 200.",
  "$comment": "Was: api.md 38-40",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    }
  },
  "allOf": [
    {
      "$ref": "https://vision-board.invalid/schema/api/problem.schema.json#/$defs/core"
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "code": {
      "type": "string",
      "pattern": "^https://vision-board\\.invalid/problems/(bad-request|not-authenticated|forbidden|needs-grant|not-found|method-not-allowed|conflict|too-large|unsupported-media-type|depends-on-failed|invalid|server-error|wrong-folder|locked|needs-approval|app-not-found|app-invalid|app-failed|app-busy|app-timeout)$",
      "description": "`https://vision-board.invalid/problems/<code>`; the codes are listed in the API reference.",
      "$comment": "Was: api.md 40"
    },
    "codes": {
      "type": "object",
      "description": "Every problem code, with the HTTP status it is sent with (`const`) and its `title` (the same for every problem with that code). The source of the codes: the server and the client are generated from it (scripts/gen-api.mjs), and `code`'s pattern must list exactly these.",
      "$comment": "423 Locked (RFC 4918 11.3): the board itself is locked, so a client can tell it from every 409 by status alone. The app codes are D-047 rulings 6-8 (api.md 153).",
      "properties": {
        "bad-request": {
          "const": 400,
          "title": "Bad request"
        },
        "not-authenticated": {
          "const": 401,
          "title": "Not authenticated"
        },
        "forbidden": {
          "const": 403,
          "title": "Forbidden"
        },
        "needs-grant": {
          "const": 403,
          "title": "Needs a grant"
        },
        "not-found": {
          "const": 404,
          "title": "Not found"
        },
        "method-not-allowed": {
          "const": 405,
          "title": "Method not allowed"
        },
        "conflict": {
          "const": 409,
          "title": "Conflict"
        },
        "too-large": {
          "const": 413,
          "title": "Too large"
        },
        "unsupported-media-type": {
          "const": 415,
          "title": "Unsupported media type"
        },
        "depends-on-failed": {
          "const": 422,
          "title": "Depends on a failed item"
        },
        "invalid": {
          "const": 422,
          "title": "Invalid"
        },
        "server-error": {
          "const": 500,
          "title": "Server error"
        },
        "wrong-folder": {
          "const": 409,
          "title": "Wrong folder"
        },
        "locked": {
          "const": 423,
          "title": "Locked"
        },
        "needs-approval": {
          "const": 403,
          "title": "Needs approval"
        },
        "app-not-found": {
          "const": 404,
          "title": "App not found"
        },
        "app-invalid": {
          "const": 422,
          "title": "App invalid"
        },
        "app-failed": {
          "const": 502,
          "title": "App failed"
        },
        "app-busy": {
          "const": 503,
          "title": "App busy"
        },
        "app-timeout": {
          "const": 504,
          "title": "App timed out"
        }
      },
      "additionalProperties": false
    },
    "pointerError": {
      "type": "object",
      "required": [
        "pointer",
        "detail"
      ],
      "properties": {
        "pointer": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$",
          "description": "A JSON Pointer into the request body, such as /items/2/node/title"
        },
        "detail": {
          "$ref": "https://vision-board.invalid/schema/ledger/19/common.schema.json#/$defs/text",
          "description": "What is wrong at that pointer."
        }
      },
      "unevaluatedProperties": false
    },
    "core": {
      "type": "object",
      "description": "The members every problem has, plus the extensions some codes add.",
      "$comment": "Left open so `status` can join it. Was: api.md 39",
      "required": [
        "type",
        "title",
        "detail"
      ],
      "properties": {
        "type": {
          "$ref": "https://vision-board.invalid/schema/api/problem.schema.json#/$defs/code"
        },
        "title": {
          "$ref": "https://vision-board.invalid/schema/ledger/19/common.schema.json#/$defs/text",
          "description": "A short name for the kind of error; the same for every problem with this `type`."
        },
        "detail": {
          "$ref": "https://vision-board.invalid/schema/ledger/19/common.schema.json#/$defs/text",
          "description": "Plain English for an agent to act on: what is wrong and what to do"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "https://vision-board.invalid/schema/api/problem.schema.json#/$defs/pointerError"
          },
          "description": "Where in the request body each fault is, when there is more than one."
        },
        "example": {
          "description": "`invalid`: a worked request that fits, in the shape the refused item or body should have: for a refused write item, the example of its `type`; for a refused body, the operation's request example."
        },
        "ver": {
          "$ref": "https://vision-board.invalid/schema/ledger/19/common.schema.json#/$defs/version",
          "description": "`conflict`: the node's current version"
        },
        "board": {
          "$ref": "https://vision-board.invalid/schema/ledger/19/common.schema.json#/$defs/id",
          "description": "`needs-grant`: the board the agent needs, or the board the region is on"
        },
        "region": {
          "$ref": "https://vision-board.invalid/schema/ledger/19/common.schema.json#/$defs/id",
          "description": "`needs-grant`: the region the agent needs; left out when it needs the board"
        }
      }
    },
    "item": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://vision-board.invalid/schema/api/problem.schema.json#/$defs/core"
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
