{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-board.invalid/schema/api/problem.schema.json",
  "title": "Problem details",
  "description": "Every error is `application/problem+json`. `$defs/item` is the same object without `status`, for a failed write item, because the response's own status is 200.",
  "$comment": "Was: api.md 38-40",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    }
  },
  "allOf": [
    {
      "$ref": "https://vision-board.invalid/schema/api/problem.schema.json#/$defs/core"
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "code": {
      "type": "string",
      "pattern": "^https://vision-board\\.invalid/problems/(bad-request|not-authenticated|forbidden|needs-grant|not-found|method-not-allowed|conflict|too-large|unsupported-media-type|depends-on-failed|invalid|server-error)$",
      "description": "`https://vision-board.invalid/problems/<code>`; the codes are listed in the API reference.",
      "$comment": "Was: api.md 40"
    },
    "pointerError": {
      "type": "object",
      "required": [
        "pointer",
        "detail"
      ],
      "properties": {
        "pointer": {
          "type": "string",
          "pattern": "^(/([^/~]|~[01])*)*$",
          "description": "A JSON Pointer into the request body, such as /items/2/node/title"
        },
        "detail": {
          "$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/text",
          "description": "What is wrong at that pointer."
        }
      },
      "unevaluatedProperties": false
    },
    "core": {
      "type": "object",
      "description": "The members every problem has, plus the extensions some codes add.",
      "$comment": "Left open so `status` can join it. Was: api.md 39",
      "required": [
        "type",
        "title",
        "detail"
      ],
      "properties": {
        "type": {
          "$ref": "https://vision-board.invalid/schema/api/problem.schema.json#/$defs/code"
        },
        "title": {
          "$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/text",
          "description": "A short name for the kind of error; the same for every problem with this `type`."
        },
        "detail": {
          "$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/text",
          "description": "Plain English for an agent to act on: what is wrong and what to do"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "https://vision-board.invalid/schema/api/problem.schema.json#/$defs/pointerError"
          },
          "description": "Where in the request body each fault is, when there is more than one."
        },
        "ver": {
          "$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/version",
          "description": "`conflict`: the node's current version"
        },
        "board": {
          "$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/id",
          "description": "`needs-grant`: the board the agent needs"
        },
        "region": {
          "$ref": "https://vision-board.invalid/schema/ledger/7/common.schema.json#/$defs/id",
          "description": "`needs-grant`: the region the agent needs"
        }
      }
    },
    "item": {
      "type": "object",
      "allOf": [
        {
          "$ref": "https://vision-board.invalid/schema/api/problem.schema.json#/$defs/core"
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
