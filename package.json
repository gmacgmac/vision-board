{
  "name": "vision-board",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace apps/board",
    "board": "npm run build && node apps/board/server.ts",
    "serve": "node apps/board/server.ts",
    "dev": "npm run build && VB_PROJECT=temp/demo VB_SEED=packages/format/fixtures/roadmap.ledger.jsonl node apps/board/server.ts",
    "watch": "npm run build --workspace apps/board -- --watch",
    "check": "npm run check --workspace apps/board && tsc -p tsconfig.json",
    "validate": "node apps/board/bin/validate.ts",
    "reply": "node apps/board/bin/reply.ts",
    "test": "node --test \"packages/*/tests/**/*.test.ts\" \"apps/*/tests/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "verify": "node scripts/verify.mjs",
    "map": "node scripts/verify.mjs --write-map",
    "test:pages": "playwright test --config tests/pages/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "axe-core": "4.13.0",
    "typescript": "6.0.3"
  }
}
