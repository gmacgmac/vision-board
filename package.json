{
  "name": "vision-board",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "imports": {
    "#actions": "./packages/actions/src/index.ts",
    "#agent": "./packages/agent/src/index.ts",
    "#agent/testing": "./packages/agent/tests/support.ts",
    "#board": "./apps/board/src/board/index.ts",
    "#board/engine": "./apps/board/server/engine/index.ts",
    "#board/styles.css": "./apps/board/src/styles/sheets.css",
    "#board/testing": "./apps/board/tests/support.ts",
    "#chat": "./packages/chat/src/index.ts",
    "#chat/files": "./packages/chat/src/files.ts",
    "#chat/styles.css": "./packages/chat/src/chat.css",
    "#cli": "./packages/cli/src/index.ts",
    "#client": "./packages/client/src/index.ts",
    "#format": "./packages/format/src/index.ts",
    "#format/files": "./packages/format/src/files.ts",
    "#format/gallery.ledger.jsonl": "./packages/format/fixtures/gallery.ledger.jsonl",
    "#format/testing": "./packages/format/tests/support.ts",
    "#layout": "./packages/layout/src/index.ts",
    "#mcp": "./packages/mcp/src/index.ts",
    "#documents": "./packages/documents/src/index.ts",
    "#search": "./packages/search/src/index.ts",
    "#tokens/styles.css": "./packages/tokens/src/tokens.css",
    "#ui": "./packages/ui/src/index.ts",
    "#ui/styles.css": "./packages/ui/src/styles.css"
  },
  "scripts": {
    "build": "vite build --config apps/board/vite.config.ts",
    "board": "npm run build && node apps/board/server.ts",
    "serve": "node apps/board/server.ts",
    "dev": "npm run build && VB_PROJECT=temp/demo VB_SEED=packages/format/fixtures/roadmap.ledger.jsonl node apps/board/server.ts",
    "board:watch": "node scripts/board-watch.mjs",
    "watch": "vite build --config apps/board/vite.config.ts --watch",
    "build:plugin": "node apps/board/bin/build-plugin.ts",
    "check": "svelte-check --tsconfig apps/board/tsconfig.json && tsc -p tsconfig.json",
    "validate": "node apps/board/bin/validate.ts",
    "reply": "node apps/board/bin/reply.ts",
    "vb": "node packages/cli/bin/vb.ts",
    "mcp": "node packages/mcp/bin/vb-mcp.ts",
    "test": "node --test --test-timeout=120000 \"packages/*/tests/**/*.test.ts\" \"apps/*/tests/**/*.test.ts\" \"scripts/*.test.mjs\" \"skills/**/*.test.mjs\" \"tests/plugin/*.test.ts\" \"tests/evals/**/*.test.ts\" && npm run test:timing",
    "test:timing": "node --test --test-concurrency=1 \"packages/*/tests/**/*.timing.ts\" \"apps/*/tests/**/*.timing.ts\"",
    "verify": "node scripts/verify.mjs",
    "map": "node scripts/verify.mjs --write-map",
    "gen": "node scripts/gen-api.mjs",
    "test:pages": "playwright test --config tests/pages/playwright.config.ts",
    "test:plugin": "playwright test --config tests/plugin/playwright.config.ts",
    "eval:bot": "node tests/evals/bot/run.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "axe-core": "4.13.0",
    "pdfjs-dist": "6.4.299",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
